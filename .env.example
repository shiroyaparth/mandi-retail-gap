# =====================================================================
# KrishiPulse Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with secrets to version control.
# =====================================================================

# Database Connection (Neon / Supabase / local PostgreSQL)
# Example: postgresql://username:password@ep-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/krishipulse

# Test Database (Local scratch DB used by pytest; DROP SCHEMA public CASCADE is run here!)
# Example: postgresql://postgres@localhost:5433/kp_test
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/kp_test

# Data.gov.in API Key (Optional auto-source for wholesale prices)
# Register free at https://data.gov.in to obtain your key
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Retail Google Sheet URL (Published CSV export link)
# Example: https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv
RETAIL_SHEET_URL=https://docs.google.com/spreadsheets/d/e/your_sheet_id/pub?gid=0&single=true&output=csv

# Telegram Alerting (Optional: Free price anomaly push alerts)
# 1. Talk to @BotFather on Telegram to create a bot and get the token
# 2. Get your numeric chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Email Alerting via SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=recipient_email@gmail.com
